# NeerSense Environment Configuration

# Toggle Firebase data source (true = Firebase Firestore & Data Connect, false = local Express server)
VITE_USE_FIRESTORE=false

# Firebase Project Credentials (from Firebase Console -> Project Settings -> General -> Your apps)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=neersense-a5df3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=neersense-a5df3
VITE_FIREBASE_STORAGE_BUCKET=neersense-a5df3.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Optional: Firebase Data Connect Connector & Location
VITE_DATA_CONNECT_LOCATION=asia-south1
VITE_DATA_CONNECT_SERVICE=neersense-service

# Optional: Firebase Local Emulator
VITE_USE_FIREBASE_EMULATOR=false
